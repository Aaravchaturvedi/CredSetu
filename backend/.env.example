# Copy this file to .env before running the API:
#   cp .env.example .env
# Never commit .env — it is already listed in the root .gitignore.

# PostgreSQL connection (matches docker-compose.yml).
DATABASE_URL="postgresql://miniledger:miniledger@localhost:5432/miniledger?schema=public"

# HTTP server.
PORT=4000
NODE_ENV=development

# Mock authentication. Use a long random value outside local development.
# Example generator: openssl rand -hex 32
JWT_SECRET="dev-only-change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# How long a login OTP remains valid.
OTP_TTL_MINUTES=5

# Local receipt image storage. When testing on a physical phone, change
# PUBLIC_BASE_URL to the computer's LAN address (e.g. http://192.168.1.20:4000)
# so the returned image URLs are reachable from the device.
UPLOAD_DIR="uploads"
PUBLIC_BASE_URL="http://localhost:4000"
