// MiniLedger database schema
// --------------------------
// Prisma is the single source of truth for the PostgreSQL structure.
// After changing this file, run:
//   npm run db:migrate -- --name <short_description>
// which creates a SQL migration and regenerates the typed Prisma client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A MiniLedger account. A phone number uniquely identifies a user.
/// Users are created only after a successful OTP verification.
model User {
  id          String   @id @default(uuid()) @db.Uuid
  phoneNumber String   @unique @map("phone_number") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  loans Loan[]

  @@map("users")
}

/// Short-lived one-time passwords for the mock phone login.
/// This is kept separate from User because an OTP is issued before we know
/// whether the phone number belongs to an existing user.
model OtpCode {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @map("phone_number") @db.VarChar(20)

  /// SHA-256 hash of the 6-digit code. The plain OTP is only printed to the
  /// server console for this mock flow, never stored in the database.
  codeHash   String    @map("code_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Speeds up "find the newest valid OTP for this phone" queries.
  @@index([phoneNumber, expiresAt])
  @@map("otp_codes")
}

/// Money the user lent to a friend.
model Loan {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  friendName String @map("friend_name") @db.VarChar(120)

  /// Exact monetary value with two decimal places. Prisma maps this to
  /// JavaScript `Decimal`; it must never be converted to a float in SQL.
  amount Decimal @db.Decimal(12, 2)

  /// Date-only value (no time component). The API accepts YYYY-MM-DD.
  dueDate DateTime @map("due_date") @db.Date

  isRepaid Boolean @default(false) @map("is_repaid")

  /// Optional path/URL of an uploaded receipt image.
  receiptImageUrl String? @map("receipt_image_url") @db.VarChar(2048)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Deleting a user deletes their loans, preventing orphaned rows.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Supports the loan list (filtered by user, ordered by due date) and the
  // dashboard summary (filtered by user + repayment status).
  @@index([userId, dueDate])
  @@index([userId, isRepaid, dueDate])
  @@map("loans")
}
